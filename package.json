{
  "name": "larkinfra",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:gateway": "pnpm --filter @larkinfra/gateway dev",
    "dev:agent": "pnpm --filter @larkinfra/echo-agent start",
    "dev:web": "pnpm --filter @larkinfra/web dev",
    "build:web": "pnpm --filter @larkinfra/web build",
    "typecheck": "pnpm -r run typecheck",
    "pm2:build": "pnpm --filter @larkinfra/shared build && pnpm --filter @larkinfra/web build && pnpm --filter @larkinfra/gateway build",
    "pm2:start": "pnpm pm2:build && pm2 start ecosystem.config.cjs",
    "pm2:reload": "pnpm pm2:build && pm2 reload ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs larkinfra-gateway --lines 50",
    "deploy:remote": "bash scripts/deploy.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
